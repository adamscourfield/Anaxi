DATABASE_URL="postgresql://postgres:postgres@localhost:5432/anaxi"
NEXTAUTH_URL="http://localhost:3000" # public app URL (required for auth callbacks and email links)
NEXTAUTH_SECRET="replace-with-long-random-secret" # required in production
CRON_SECRET="replace-with-cron-secret" # required in production for /api/cron/*
RESEND_API_KEY=""
RESEND_WEBHOOK_SECRET="" # required in production when using Resend delivery webhooks
SENTRY_DSN="" # optional; not wired yet — errors go to structured logs via captureException
IMPORT_RETENTION_DAYS="90"
IMPORT_STORAGE_DIR="" # optional; defaults to ./storage/imports (use shared storage when running multiple instances)
APP_URL="" # optional fallback for email links when NEXTAUTH_URL is unset
FROM_EMAIL="hi@anaxi.io"
# ANTHROPIC_API_KEY="" # required for AI Explorer briefing (falls back to static copy when missing)
